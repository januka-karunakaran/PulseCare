# ==============================================================================
# Hospital Management System (HMS) - Root Environment Configuration Template
# ==============================================================================

# Database Settings
MONGODB_URI=mongodb://localhost:27017/hospital_management_db
MONGODB_DATABASE=hospital_management_db
MONGO_ROOT_USER=admin
MONGO_ROOT_PASSWORD=secureAdminPassword123

# Backend Spring Boot Configuration
SERVER_PORT=8080
SPRING_PROFILES_ACTIVE=dev
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION=86400000

# CORS & Gateway
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
WS_ALLOWED_ORIGINS=*

# Frontend Next.js Configuration
NEXT_PUBLIC_API_BASE=http://localhost:8080/api
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws

# Optional Mail Notifications
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=notifications@hospital.com
MAIL_PASSWORD=your-secure-app-password
